{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcalbum.local/schema/site.schema.json",
  "title": "McAlbum site configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "worldStatement", "principles", "timeZone", "startedAt", "worldDay", "minecraftVersion", "fabricVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "worldStatement": { "type": "string", "minLength": 1 },
    "principles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "timeZone": { "const": "Asia/Shanghai" },
    "startedAt": { "type": "string", "format": "date" },
    "worldDay": { "type": ["integer", "null"], "minimum": 0 },
    "minecraftVersion": { "type": "string", "minLength": 1 },
    "fabricVersion": { "type": "string", "minLength": 1 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcalbum.local/schema/player.schema.json",
  "title": "Player",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "bio", "status"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "bio": { "type": "string" },
    "status": { "enum": ["resident", "historical", "private"] },
    "avatarAssetId": { "type": ["string", "null"] },
    "joinedAt": { "type": ["string", "null"], "format": "date" },
    "workIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}

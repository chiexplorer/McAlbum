MYSQL_DATABASE=mcalbum
MYSQL_USER=mcalbum
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MCALBUM_DATABASE_URL=mysql+pymysql://mcalbum:change-me@127.0.0.1:3306/mcalbum?charset=utf8mb4
MCALBUM_MEDIA_ROOT=../../storage
MCALBUM_CORS_ORIGINS=["http://localhost:3000"]
MCALBUM_TRUSTED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MCALBUM_SESSION_TTL_HOURS=168
MCALBUM_REGISTRATION_RATE_WINDOW_SECONDS=3600
MCALBUM_MEDIA_UPLOAD_LIMIT_USER=20
MCALBUM_MEDIA_UPLOAD_LIMIT_ADMIN=100
MCALBUM_COOKIE_SECURE=false
MCALBUM_ENABLE_BUILD_TRIGGER=false
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
# 生产构建推荐改为同源 /api，并由 Nginx 反向代理到 FastAPI。

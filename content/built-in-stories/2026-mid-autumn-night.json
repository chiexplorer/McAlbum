{
    "$schema":  "../../contracts/json-schema/built-in-story.schema.json",
    "id":  "2026-mid-autumn-night",
    "story":  {
                  "id":  "2026-mid-autumn-night",
                  "title":  "2026 年中秋夜",
                  "summary":  "一次围绕中式布景、节日灯笼、市集摊位和烟花表演展开的服务器聚会。",
                  "coverAssetId":  "media-built-in-mid-autumn-fireworks",
                  "playerIds":  [

                                ],
                  "sections":  [
                                   {
                                       "id":  "opening",
                                       "type":  "text",
                                       "body":  "这次中秋夜以太极广场附近的中式建筑为背景。灯笼、摊位和烟花把原本熟悉的出生点区域变成了一个短暂的节日现场。"
                                   },
                                   {
                                       "id":  "square-overview",
                                       "type":  "wide-image",
                                       "assetId":  "media-built-in-mid-autumn-overview",
                                       "caption":  "从高处望向广场周边，可以看到建筑、道路、绿化和玩家共同留下的建设痕迹。"
                                   },
                                   {
                                       "id":  "gathering",
                                       "type":  "image-grid",
                                       "assetIds":  [
                                                        "media-built-in-mid-autumn-gathering-01",
                                                        "media-built-in-mid-autumn-gathering-02",
                                                        "media-built-in-mid-autumn-gathering-03"
                                                    ],
                                       "caption":  "活动开始前后，玩家在门楼和灯笼下尝试了几种不同的合影站位。"
                                   },
                                   {
                                       "id":  "market",
                                       "type":  "text-with-image",
                                       "body":  "摊位和食物让这次活动不只有宏大的门楼与烟花，也留下了玩家停留、交谈和分享物品的日常片段。",
                                       "assetId":  "media-built-in-mid-autumn-market",
                                       "imagePosition":  "right"
                                   },
                                   {
                                       "id":  "fireworks",
                                       "type":  "wide-image",
                                       "assetId":  "media-built-in-mid-autumn-fireworks",
                                       "caption":  "夜色落下后，粉色和紫色烟花在门楼上方铺开。"
                                   },
                                   {
                                       "id":  "after-the-event",
                                       "type":  "text-with-image",
                                       "body":  "散场后，街道上的灯笼和烛光继续照亮石板路。安静的空景为这组记录留下了自然的结尾。",
                                       "assetId":  "media-built-in-mid-autumn-after-event",
                                       "imagePosition":  "left"
                                   }
                               ],
                  "status":  "published",
                  "isMock":  false
              },
